# Performa environment template — copy to .env and fill in real values.
# .env is gitignored; never commit secrets. No quotes around values.
#
# Firebase (required): service-account JSON path + project id.
# Place firebase-service-account.json in the project root (also gitignored).
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
FIREBASE_PROJECT_ID=performa-36cc9
# Browser API key (public by design; restrict by HTTP referrer in GCP console).
FIREBASE_API_KEY=
#
# Gemini (required for AI training recommendations; without it the pipeline
# returns a graceful fallback and ratings still save).
GEMINI_API_KEY=
#
# Brevo transactional email, free tier 300/day (required for welcome emails;
# without it account creation still succeeds via one-time session flash).
# The sender address must be a verified sender in the Brevo dashboard.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Performa
#
# Python interpreter override (optional): full path to a Python with
# scikit-learn. If unset, backend/ml_bridge.php auto-selects the first
# candidate that imports sklearn. Example:
# PYTHON_EXEC=C:\Users\andrew\AppData\Local\Python\pythoncore-3.14-64\python.exe
PYTHON_EXEC=
